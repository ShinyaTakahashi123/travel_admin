// 旅しおり共有サービス Prismaスキーマ
//
// ⚠️ 重要: このスキーマは3リポジトリ（user-site / planner-site / admin-site）で
// 同一のものを複製して保持する運用とする（共有DBのテーブル構造は完全に一致させる必要があるため）。
// マイグレーション（`prisma migrate dev`）は admin-site リポジトリでのみ実行し、
// 他の2リポジトリは `prisma generate` のみ行う（migrate は実行しない）こと。
// スキーマを変更したら、必ず3リポジトリすべてに同じ内容を反映すること。
//
// 対応するDDL・ER図・設計判断の詳細は docs/database-design.md を参照。
//
// ⚠️ Prismaは任意のCHECK制約を直接表現できないため、database-design.md記載の
// CHECK制約・pg_trgmインデックスは、prisma/migrations配下の生成済みSQLに
// 手動で追記する運用とする（本ディレクトリの README.md 参照）。
//
// ⚠️ 開発機がWindows ARM64のため、Prisma Clientはネイティブのquery engineバイナリ
// （x64専用ビルドで「not a valid Win32 application」エラーになる）ではなく、
// driverAdapters（@prisma/adapter-pg）経由でDB接続する構成に固定している。
// generator の `engineType = "client"` がこれに対応する設定で、これが無いと
// adapterを渡してもクライアントは内部でネイティブengineのロードを試みてしまう
// （2025年時点のPrisma 6の既知の挙動）。詳細は src/lib/prisma.ts 参照。

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
  engineType      = "client"
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [pgcrypto, pg_trgm]
}

// ============================================================
// マスタ系
// ============================================================

model Area {
  id           String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name         String
  level        String // "prefecture" | "area"
  parentId     String? @map("parent_id") @db.Uuid
  displayOrder Int     @default(0) @map("display_order")
  // 都道府県・エリアまとめページ(/area/{pref}[/{area}])のURL用。半角英小文字・数字・ハイフンのみ。
  // 未設定(null)のエリアはまとめページを作らない。同じ都道府県内での重複はDB側で防止(@@unique)。
  // 都道府県同士(parentIdがnullの行同士)の重複防止は、Prismaで表現できない部分一意インデックス
  // (parent_id IS NULL AND slug IS NOT NULLの範囲のみ対象)をマイグレーションで別途作成している
  slug         String?
  // まとめページの導入文・meta descriptionに使う紹介文(100〜200字)。未設定なら自動生成の文言を使う
  description  String?

  parent   Area?  @relation("AreaHierarchy", fields: [parentId], references: [id])
  children Area[] @relation("AreaHierarchy")

  userAccountsHome     UserAccount[]        @relation("UserHomeArea")
  plannerAccountsHome  PlannerAccount[]     @relation("PlannerHomeArea")
  userWishlistAreas    UserWishlistArea[]
  plannerServiceAreas  PlannerServiceArea[]
  itineraryAreas       ItineraryArea[]
  itinerariesAsPrimary Itinerary[]          @relation("ItineraryPrimaryArea")
  prefectureVisits     PrefectureVisit[]

  @@unique([parentId, slug])
  @@index([parentId])
  @@map("area")
}

model PlaceMaster {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String
  address   String?
  lat       Decimal? @db.Decimal(9, 6)
  lng       Decimal? @db.Decimal(9, 6)
  category  String?
  source    String // "ai_collected" | "user_submitted"
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  spots Spot[]

  @@map("place_master")
}

model Tag {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String   @unique
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  userInterestTags     UserInterestTag[]
  plannerSpecialtyTags PlannerSpecialtyTag[]
  itineraryTags        ItineraryTag[]
  themeTags            ThemeTag[]

  @@map("tag")
}

// 目的タグ（お寺・温泉・自然・グランピング等）。しおりの「テーマ・ジャンル」(Tag)とは
// 別軸のマスタとして独立させている。しおり登録時は任意入力。
model PurposeTag {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String   @unique
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  itineraryPurposeTags ItineraryPurposeTag[]
  themePurposeTags     ThemePurposeTag[]

  @@map("purpose_tag")
}

// ============================================================
// ユーザーサイト
// ============================================================

model UserAccount {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                String
  email               String    @unique
  passwordHash        String?   @map("password_hash") // Googleログインのみのアカウントはパスワード未設定のためNULL許容
  googleId            String?   @unique @map("google_id")
  iconUrl             String?   @map("icon_url")
  profile             String?
  gender              String?
  age                 Int?
  status              String    @default("active") // "active" | "suspended"
  homeAreaId          String?   @map("home_area_id") @db.Uuid
  resetToken          String?   @map("reset_token")
  resetTokenExpiresAt DateTime? @map("reset_token_expires_at") @db.Timestamptz
  // パスワードを変更した時刻。これより前に発行されたログイン情報(JWT)は無効にする
  passwordChangedAt   DateTime? @map("password_changed_at") @db.Timestamptz
  // 権利侵害の申告・開示請求の対応中など、手続き中の保全の印(true=画面からの退会を止める)。
  // 管理者サイトのアカウント詳細でスーパー管理者のみ付け外しできる
  legalHold           Boolean   @default(false) @map("legal_hold")
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt           DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  homeArea         Area?              @relation("UserHomeArea", fields: [homeAreaId], references: [id])
  wishlistAreas    UserWishlistArea[]
  interestTags     UserInterestTag[]
  subscription     Subscription?
  favorites        Favorite[]
  comments         Comment[]
  reports          Report[]
  sentRequests     Request[]
  trips            Trip[]
  checkins         Checkin[]
  prefectureVisits PrefectureVisit[]

  @@index([homeAreaId])
  @@map("user_account")
}

model UserWishlistArea {
  userAccountId String @map("user_account_id") @db.Uuid
  areaId        String @map("area_id") @db.Uuid

  userAccount UserAccount @relation(fields: [userAccountId], references: [id], onDelete: Cascade)
  area        Area        @relation(fields: [areaId], references: [id], onDelete: Cascade)

  @@id([userAccountId, areaId])
  @@map("user_wishlist_area")
}

model UserInterestTag {
  userAccountId String @map("user_account_id") @db.Uuid
  tagId         String @map("tag_id") @db.Uuid

  userAccount UserAccount @relation(fields: [userAccountId], references: [id], onDelete: Cascade)
  tag         Tag         @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([userAccountId, tagId])
  @@map("user_interest_tag")
}

model Subscription {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userAccountId   String    @unique @map("user_account_id") @db.Uuid
  plan            String    @default("free") // "free" | "premium"
  startedAt       DateTime  @default(now()) @map("started_at") @db.Timestamptz
  expiredAt       DateTime? @map("expired_at") @db.Timestamptz
  paymentProvider String?   @map("payment_provider")
  paymentRef      String?   @map("payment_ref")

  userAccount UserAccount @relation(fields: [userAccountId], references: [id], onDelete: Cascade)

  @@map("subscription")
}

// ============================================================
// プランナーサイト
// ============================================================

model PlannerAccount {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                String
  email               String    @unique
  passwordHash        String?   @map("password_hash") // Googleログインのみのアカウントはパスワード未設定のためNULL許容
  googleId            String?   @unique @map("google_id")
  iconUrl             String?   @map("icon_url")
  profile             String? // 自己紹介文
  isOfficial          Boolean   @default(false) @map("is_official")
  gender              String?
  age                 Int?
  status              String    @default("active") // "active" | "suspended"
  homeAreaId          String?   @map("home_area_id") @db.Uuid
  resetToken          String?   @map("reset_token")
  resetTokenExpiresAt DateTime? @map("reset_token_expires_at") @db.Timestamptz
  // パスワードを変更した時刻。これより前に発行されたログイン情報(JWT)は無効にする
  passwordChangedAt   DateTime? @map("password_changed_at") @db.Timestamptz
  // 権利侵害の申告・開示請求の対応中など、手続き中の保全の印(true=画面からの退会を止める)。
  // 管理者サイトのアカウント詳細でスーパー管理者のみ付け外しできる
  legalHold           Boolean   @default(false) @map("legal_hold")
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt           DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  homeArea         Area?                 @relation("PlannerHomeArea", fields: [homeAreaId], references: [id])
  serviceAreas     PlannerServiceArea[]
  specialtyTags    PlannerSpecialtyTag[]
  itineraries      Itinerary[]
  receivedRequests Request[]

  @@index([homeAreaId])
  @@map("planner_account")
}

model PlannerServiceArea {
  plannerAccountId String @map("planner_account_id") @db.Uuid
  areaId           String @map("area_id") @db.Uuid

  plannerAccount PlannerAccount @relation(fields: [plannerAccountId], references: [id], onDelete: Cascade)
  area           Area           @relation(fields: [areaId], references: [id], onDelete: Cascade)

  @@id([plannerAccountId, areaId])
  @@map("planner_service_area")
}

model PlannerSpecialtyTag {
  plannerAccountId String @map("planner_account_id") @db.Uuid
  tagId            String @map("tag_id") @db.Uuid

  plannerAccount PlannerAccount @relation(fields: [plannerAccountId], references: [id], onDelete: Cascade)
  tag            Tag            @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([plannerAccountId, tagId])
  @@map("planner_specialty_tag")
}

// ============================================================
// 管理者サイト
// ============================================================

model Admin {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                String
  email               String    @unique
  passwordHash        String?   @map("password_hash") // 招待中(status='invited')はNULL
  role                String // "super" | "staff"
  status              String    @default("invited") // "invited" | "active" | "disabled"
  inviteToken         String?   @map("invite_token")
  inviteExpiresAt     DateTime? @map("invite_expires_at") @db.Timestamptz
  resetToken          String?   @map("reset_token")
  resetTokenExpiresAt DateTime? @map("reset_token_expires_at") @db.Timestamptz
  // パスワードを変更した時刻。これより前に発行されたログイン情報(JWT)は無効にする
  passwordChangedAt   DateTime? @map("password_changed_at") @db.Timestamptz
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt           DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  reviewedItineraries Itinerary[]
  auditLogs           AdminAuditLog[]

  @@map("admin")
}

// 管理者の操作の記録(承認・却下・利用停止・削除などの経緯)。画面から編集・削除はできない。
// detailには、変更前後の状態・却下理由・しおりのタイトルなど「運営者が書いた文章」のみ入れる。
// 利用者・プランナーのメールアドレス・名前・IPアドレス、通報やお問い合わせの本文は入れない
// (対象はtargetIdで分かる)。保存期間は3年(Cronで削除。legalHold=trueのものは対象外)
model AdminAuditLog {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  adminId    String   @map("admin_id") @db.Uuid
  action     String
  targetType String   @map("target_type") // itinerary|user_account|planner_account|admin|report|inquiry
  targetId   String   @map("target_id") @db.Uuid
  detail     Json?    @db.JsonB
  // 裁判・開示請求の手続きが続いているなど、法務が保存を求めた記録は3年を過ぎても消さない。
  // 付け外しはDBの直接操作でよく、画面は不要
  legalHold  Boolean  @default(false) @map("legal_hold")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz

  admin Admin @relation(fields: [adminId], references: [id])

  @@index([targetType, targetId])
  @@index([createdAt])
  @@map("admin_audit_log")
}

// ============================================================
// しおり本体
// ============================================================

model Itinerary {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  plannerAccountId   String    @map("planner_account_id") @db.Uuid
  title              String
  description        String?
  nights             Int       @default(0) // 0 = 日帰り
  status             String    @default("draft") // draft|pending|published|rejected|private|deleted
  thumbnailUrl       String?   @map("thumbnail_url")
  viewCount          BigInt    @default(0) @map("view_count")
  likeCount          BigInt    @default(0) @map("like_count") // ログイン不要の「いいね」カウンタ（お気に入りFavoriteとは別概念）
  primaryAreaId      String?   @map("primary_area_id") @db.Uuid // 主な都道府県（複数県にまたがる場合も1つ選択。都道府県レベルのArea.idを指す）
  submittedAt        DateTime? @map("submitted_at") @db.Timestamptz
  // 権利侵害の申告・開示請求への対応のため公開申請時に記録(再申請のたびに上書き。6か月後にCronでnullにする)
  submittedIp        String?   @map("submitted_ip")
  reviewedAt         DateTime? @map("reviewed_at") @db.Timestamptz
  reviewedByAdminId  String?   @map("reviewed_by_admin_id") @db.Uuid
  rejectionReason    String?   @map("rejection_reason")
  // 旅のじゅんび(持ち物)。選択肢(プログラム内に用意したもの)のIDと、プランナーが
  // テキストで追加した言葉(順番つき)。どちらも未選択なら印刷時にテーマ・目的タグから自動で出す
  packingItemIds     String[]  @default([]) @map("packing_item_ids")
  packingCustomItems String[]  @default([]) @map("packing_custom_items")
  // おすすめの季節("spring"|"summer"|"autumn"|"winter"、重複なし)。「通年」の区分はなく、
  // どの季節でも楽しめるしおりは4つすべてを持たせる。未設定(空配列)のしおりは、
  // プランナーの既存のしおりなど運営がデータを書き換えないものも含め、
  // どの季節のページにも出す(4つすべて選んだときと同じ扱い)
  seasons            String[]  @default([]) @map("seasons")
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  // 公式しおりの「コピーしてアレンジ」(dev/copy-and-share、未マージ・共有DBには適用済み)。
  // コピーはpublished/pendingにできない(DBのCHECK制約でも二重に防ぐ)
  isCopy       Boolean @default(false) @map("is_copy")
  copiedFromId String? @map("copied_from_id") @db.Uuid

  // 会員だけが見られる限定公開リンク(dev/copy-and-share、未マージ・共有DBには適用済み)
  sharedLinkTokenHash String?   @unique @map("shared_link_token_hash")
  sharedLinkCreatedAt DateTime? @map("shared_link_created_at") @db.Timestamptz
  sharedLinkConsentAt DateTime? @map("shared_link_consent_at") @db.Timestamptz

  plannerAccount  PlannerAccount        @relation(fields: [plannerAccountId], references: [id], onDelete: Cascade)
  primaryArea     Area?                 @relation("ItineraryPrimaryArea", fields: [primaryAreaId], references: [id])
  reviewedByAdmin Admin?                @relation(fields: [reviewedByAdminId], references: [id])
  copiedFrom      Itinerary?            @relation("ItineraryCopy", fields: [copiedFromId], references: [id], onDelete: SetNull)
  copies          Itinerary[]           @relation("ItineraryCopy")
  areas           ItineraryArea[]
  tags            ItineraryTag[]
  purposeTags     ItineraryPurposeTag[]
  days            Day[]
  favorites       Favorite[]
  comments        Comment[]
  shareLogs       ShareLog[]
  requests        Request[]
  pageViews       PageView[]
  featureItems    FeatureItem[]

  @@index([plannerAccountId])
  @@index([status])
  @@index([status, createdAt(sort: Desc)])
  @@index([status, viewCount(sort: Desc)])
  @@index([status, likeCount(sort: Desc)])
  @@index([copiedFromId])
  @@index([primaryAreaId])
  @@map("itinerary")
}

model ItineraryArea {
  itineraryId String @map("itinerary_id") @db.Uuid
  areaId      String @map("area_id") @db.Uuid

  itinerary Itinerary @relation(fields: [itineraryId], references: [id], onDelete: Cascade)
  area      Area      @relation(fields: [areaId], references: [id])

  @@id([itineraryId, areaId])
  @@index([areaId])
  @@map("itinerary_area")
}

model ItineraryTag {
  itineraryId String @map("itinerary_id") @db.Uuid
  tagId       String @map("tag_id") @db.Uuid

  itinerary Itinerary @relation(fields: [itineraryId], references: [id], onDelete: Cascade)
  tag       Tag       @relation(fields: [tagId], references: [id])

  @@id([itineraryId, tagId])
  @@index([tagId])
  @@map("itinerary_tag")
}

model ItineraryPurposeTag {
  itineraryId  String @map("itinerary_id") @db.Uuid
  purposeTagId String @map("purpose_tag_id") @db.Uuid

  itinerary  Itinerary  @relation(fields: [itineraryId], references: [id], onDelete: Cascade)
  purposeTag PurposeTag @relation(fields: [purposeTagId], references: [id])

  @@id([itineraryId, purposeTagId])
  @@index([purposeTagId])
  @@map("itinerary_purpose_tag")
}

// ============================================================
// テーマ・特集（管理者サイトで作成。docs/specs/20260927-admin-managed-themes-features.md）
// ============================================================

model Theme {
  id    String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name  String
  // URL用の名前(/theme/{slug})。名前からローマ字で自動生成し、管理者が直せる。公開後は変更不可の運用
  slug  String @unique
  intro String

  // 管理者サイトからアップロードした画像(Vercel Blob)のURL、または既存のpublic/themes/配下の
  // SVGを指す相対パス(例: /themes/theme-koyo.svg)。未設定ならユーザーサイト側で既定の絵にフォールバック
  imageUrl String? @map("image_url")

  // この季節はトップで先頭に出す(任意・複数可・空でもよい)。"spring"|"summer"|"autumn"|"winter"
  seasons String[] @default([]) @map("seasons")

  displayOrder Int    @default(0) @map("display_order")
  status       String @default("draft") @map("status") // "draft" | "published"

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  tags        ThemeTag[]
  purposeTags ThemePurposeTag[]

  @@index([status])
  @@map("theme")
}

model ThemeTag {
  themeId String @map("theme_id") @db.Uuid
  tagId   String @map("tag_id") @db.Uuid

  theme Theme @relation(fields: [themeId], references: [id], onDelete: Cascade)
  tag   Tag   @relation(fields: [tagId], references: [id])

  @@id([themeId, tagId])
  @@index([tagId])
  @@map("theme_tag")
}

model ThemePurposeTag {
  themeId      String @map("theme_id") @db.Uuid
  purposeTagId String @map("purpose_tag_id") @db.Uuid

  theme      Theme      @relation(fields: [themeId], references: [id], onDelete: Cascade)
  purposeTag PurposeTag @relation(fields: [purposeTagId], references: [id])

  @@id([themeId, purposeTagId])
  @@index([purposeTagId])
  @@map("theme_purpose_tag")
}

model Feature {
  id          String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title       String
  // URL用の名前(/feature/{slug})。公開後は変更不可の運用
  slug        String  @unique
  description String // 検索結果・meta descriptionに出す文
  lead        String // はじめの文
  closing     String? // おわりの文

  status String @default("draft") @map("status") // "draft" | "published"

  // 出す時期(任意・月の範囲。例: 9〜11月だけトップ・特集一覧に出す)。年をまたぐ範囲(例: 11〜2月)も許容し、
  // 表示側でfrom<=toなら通常の範囲、from>toなら年またぎとして扱う。時期の外でもURLでは見られる
  displayFromMonth Int? @map("display_from_month")
  displayToMonth   Int? @map("display_to_month")

  publishedAt DateTime? @map("published_at") @db.Timestamptz
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  items   FeatureItem[]
  related FeatureRelatedLink[]

  @@index([status])
  @@map("feature")
}

model FeatureItem {
  id           String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  featureId    String  @map("feature_id") @db.Uuid
  itineraryId  String  @map("itinerary_id") @db.Uuid
  // 紹介の一言(空ならユーザーサイト側でしおりの説明文の最初を使う)
  caption      String?
  displayOrder Int     @default(0) @map("display_order")

  feature   Feature   @relation(fields: [featureId], references: [id], onDelete: Cascade)
  itinerary Itinerary @relation(fields: [itineraryId], references: [id], onDelete: Cascade)

  @@unique([featureId, itineraryId])
  @@index([itineraryId])
  @@map("feature_item")
}

model FeatureRelatedLink {
  id           String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  featureId    String @map("feature_id") @db.Uuid
  href         String
  label        String
  displayOrder Int    @default(0) @map("display_order")

  feature Feature @relation(fields: [featureId], references: [id], onDelete: Cascade)

  @@map("feature_related_link")
}

model Day {
  id          String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  itineraryId String @map("itinerary_id") @db.Uuid
  dayNumber   Int    @map("day_number")

  itinerary Itinerary @relation(fields: [itineraryId], references: [id], onDelete: Cascade)
  spots     Spot[]

  @@unique([itineraryId, dayNumber])
  @@map("day")
}

model Spot {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  dayId              String    @map("day_id") @db.Uuid
  placeMasterId      String?   @map("place_master_id") @db.Uuid
  orderNo            Int       @map("order_no")
  name               String
  address            String?
  lat                Decimal?  @db.Decimal(9, 6)
  lng                Decimal?  @db.Decimal(9, 6)
  visitTime          DateTime? @map("visit_time") @db.Time
  memo               String?
  stayDurationMin    Int?      @map("stay_duration_min")
  websiteUrl         String?   @map("website_url")
  // 乗り継ぎ(SpotTransitLeg)に置き換え中の列。1つ目の移動の値と同じに保つ
  // (乗り継ぎ機能より前のコードや、乗り継ぎがまだ1つだけのときの表示に使う)
  transitMode        String?   @map("transit_mode") // walk|train|bus|car|taxi|other
  transitDurationMin Int?      @map("transit_duration_min")
  transitLine        String?   @map("transit_line")
  // 足あと地図・チェックイン用(docs/specs/20260928-footprint-map-checkin.md 5.)。
  // null のときは、呼び出し側で名前・目的タグから自動で決める
  stampCategory      String?   @map("stamp_category") // castle|temple|shrine|mountain|water|beach|onsen|museum|townscape|park|gourmet|craft|view|sake_brewery|other
  checkinRadius      String?   @map("checkin_radius") // "normal"(1km) | "wide"(3km)。nullは"normal"扱い
  isMemorial         Boolean?  @map("is_memorial") // 慰霊・戦争にかかわる場所か。nullはfalse扱い

  day         Day              @relation(fields: [dayId], references: [id], onDelete: Cascade)
  placeMaster PlaceMaster?     @relation(fields: [placeMasterId], references: [id])
  photos      Photo[]
  transitLegs SpotTransitLeg[]

  @@unique([dayId, orderNo])
  @@index([placeMasterId])
  @@map("spot")
}

// スポットへの移動(乗り継ぎ)。1区間に最大4つ、順番つきで持てる
model SpotTransitLeg {
  id                 String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  spotId             String  @map("spot_id") @db.Uuid
  orderNo            Int     @map("order_no")
  transitMode        String  @map("transit_mode") // walk|train|bus|car|taxi|other
  transitDurationMin Int?    @map("transit_duration_min")
  transitLine        String? @map("transit_line")

  spot Spot @relation(fields: [spotId], references: [id], onDelete: Cascade)

  @@unique([spotId, orderNo])
  @@map("spot_transit_leg")
}

model Photo {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  spotId     String   @map("spot_id") @db.Uuid
  url        String
  caption    String?
  // 出典(Wikipedia/Wikimedia Commons等から取り込んだ画像のクレジット表示に使う)。
  // すべて未設定なら出典表示は出さない(プランナーが自分で撮った写真など)
  sourceUrl  String?  @map("source_url") // ファイルページのURL
  author     String? // 撮影者・作者
  license    String? // ライセンスの短い名前(例: "CC BY-SA 4.0"、"パブリックドメイン")
  licenseUrl String?  @map("license_url") // ライセンスの説明ページのURL
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz

  // 「コピーしてアレンジ」で複製した写真のコピー元(dev/copy-and-share、未マージ・共有DBには適用済み)。
  // ON DELETE SET NULL(CASCADEにしない理由は該当マイグレーションのコメント参照)
  sourcePhotoId String? @map("source_photo_id") @db.Uuid

  spot        Spot    @relation(fields: [spotId], references: [id], onDelete: Cascade)
  sourcePhoto Photo?  @relation("PhotoCopy", fields: [sourcePhotoId], references: [id], onDelete: SetNull)
  copies      Photo[] @relation("PhotoCopy")

  @@index([spotId])
  @@index([sourcePhotoId])
  @@map("photo")
}

// ============================================================
// エンゲージメント
// ============================================================

model Favorite {
  userAccountId String   @map("user_account_id") @db.Uuid
  itineraryId   String   @map("itinerary_id") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz

  userAccount UserAccount @relation(fields: [userAccountId], references: [id], onDelete: Cascade)
  itinerary   Itinerary   @relation(fields: [itineraryId], references: [id], onDelete: Cascade)

  @@id([userAccountId, itineraryId])
  @@index([itineraryId])
  @@map("favorite")
}

model Comment {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  itineraryId   String   @map("itinerary_id") @db.Uuid
  userAccountId String   @map("user_account_id") @db.Uuid
  body          String
  // 権利侵害の申告・開示請求への対応のため投稿時に記録(6か月後にCronでnullにする)
  ipAddress     String?  @map("ip_address")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz

  itinerary   Itinerary   @relation(fields: [itineraryId], references: [id], onDelete: Cascade)
  userAccount UserAccount @relation(fields: [userAccountId], references: [id], onDelete: Cascade)

  @@index([itineraryId, createdAt(sort: Desc)])
  @@map("comment")
}

model Report {
  id                    String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  targetType            String   @map("target_type") // "itinerary" | "comment"
  targetId              String   @map("target_id") @db.Uuid
  reporterUserAccountId String   @map("reporter_user_account_id") @db.Uuid
  reason                String
  status                String   @default("unread") // unread|resolved|dismissed
  createdAt             DateTime @default(now()) @map("created_at") @db.Timestamptz

  reporterUserAccount UserAccount @relation(fields: [reporterUserAccountId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([targetType, targetId])
  @@map("report")
}

model Inquiry {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sourceSite String   @map("source_site") // "user" | "planner"
  category   String // 要望|質問|不具合の報告|アカウントについて|掲載内容について|その他
  name       String
  email      String
  message    String
  status     String   @default("unread") // unread|read|responded
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@index([status])
  @@index([category])
  @@index([sourceSite])
  @@map("inquiry")
}

model ShareLog {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  itineraryId String   @map("itinerary_id") @db.Uuid
  platform    String // x|facebook|line|other
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  itinerary Itinerary @relation(fields: [itineraryId], references: [id], onDelete: Cascade)

  @@index([itineraryId, platform])
  @@map("share_log")
}

model Request {
  id                  String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  plannerAccountId    String   @map("planner_account_id") @db.Uuid
  senderUserAccountId String   @map("sender_user_account_id") @db.Uuid
  itineraryId         String?  @map("itinerary_id") @db.Uuid
  message             String
  status              String   @default("unread") // unread|read|responded
  // 権利侵害の申告・開示請求への対応のため送信時に記録(6か月後にCronでnullにする)。
  // リクエスト機能の継続可否は別途判断中(docs/specs/20260924-legal-request-feature-telecom.md)
  ipAddress           String?  @map("ip_address")
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz

  plannerAccount    PlannerAccount @relation(fields: [plannerAccountId], references: [id], onDelete: Cascade)
  senderUserAccount UserAccount    @relation(fields: [senderUserAccountId], references: [id], onDelete: Cascade)
  itinerary         Itinerary?     @relation(fields: [itineraryId], references: [id], onDelete: SetNull)

  @@index([plannerAccountId, status])
  @@map("request")
}

// ============================================================
// 分析・集計
// ============================================================

model PageView {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  itineraryId String?  @map("itinerary_id") @db.Uuid
  viewedAt    DateTime @default(now()) @map("viewed_at") @db.Timestamptz

  itinerary Itinerary? @relation(fields: [itineraryId], references: [id], onDelete: SetNull)

  @@index([viewedAt])
  @@map("page_view")
}

model DailyMetric {
  id                        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  metricDate                DateTime @unique @map("metric_date") @db.Date
  totalUserAccounts         Int      @map("total_user_accounts")
  totalPublishedItineraries Int      @map("total_published_itineraries")
  pvCount                   Int      @map("pv_count")

  @@map("daily_metric")
}

// ============================================================
// 足あと地図・現地チェックイン（docs/specs/20260928-footprint-map-checkin.md）
// ============================================================

// 会員が「このしおりで旅する」を押したときに、しおりの日程・スポットを
// 会員専用にまるごと写したもの。元のしおりが変わっても・非公開や削除に
// なっても内容は変わらない(0節)
model Trip {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userAccountId       String    @map("user_account_id") @db.Uuid
  // 元のしおりのID。元のしおりが削除されても空にしない(FK制約はあえて付けない。
  // 削除依頼の対応でどの「旅」に写っているか探すのに使う。法務2026-09-28決定)
  originalItineraryId String    @map("original_itinerary_id") @db.Uuid
  title               String // 写したときのしおり名
  travelDate          DateTime? @map("travel_date") @db.Date // 旅した日(任意)
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz

  userAccount UserAccount @relation(fields: [userAccountId], references: [id], onDelete: Cascade)
  spots       TripSpot[]
  checkins    Checkin[]

  @@index([userAccountId])
  @@index([originalItineraryId])
  @@map("trip")
}

// 「旅」に写したスポット(日程を含む)。元のしおりのSpotをコピーした時点の値を持つ
model TripSpot {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tripId           String    @map("trip_id") @db.Uuid
  dayNumber        Int       @map("day_number")
  orderNo          Int       @map("order_no")
  name             String
  address          String?
  lat              Decimal?  @db.Decimal(9, 6)
  lng              Decimal?  @db.Decimal(9, 6)
  visitTime        DateTime? @map("visit_time") @db.Time
  stayDurationMin  Int?      @map("stay_duration_min")
  // 移動(乗り継ぎ)は表を増やさずJSON配列でまとめて持つ({transitMode,transitDurationMin,transitLine}[])
  transitLegsJson  Json?     @map("transit_legs_json") @db.JsonB
  // 元のしおりが見られなくなったら空にする文章(法務2026-09-28決定B)。
  // スポット名・住所・位置・日時・順番・チェックイン・スタンプは残す
  memo             String?
  photoUrl         String?   @map("photo_url")
  photoAuthor      String?   @map("photo_author")
  photoLicense     String?   @map("photo_license")
  photoLicenseUrl  String?   @map("photo_license_url")
  photoSourceUrl   String?   @map("photo_source_url")
  // 都道府県(Area.id)。写すときにスポットの住所またはしおりのエリアから決める
  prefectureAreaId String?   @map("prefecture_area_id") @db.Uuid
  stampCategory    String?   @map("stamp_category")
  isWideArea       Boolean   @default(false) @map("is_wide_area") // 判定半径3kmの広い場所か
  isMemorial       Boolean   @default(false) @map("is_memorial")

  trip     Trip      @relation(fields: [tripId], references: [id], onDelete: Cascade)
  checkins Checkin[]

  @@index([tripId])
  @@map("trip_spot")
}

// 現地チェックイン(スタンプ)の記録。現在地(緯度・経度)は端末の中で判定するだけで、
// サーバーには一度も送らない・保存しない(2026-09-28仕様2節)。残すのは
// 「いつ・どのスポットでチェックインしたか」だけ
model Checkin {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userAccountId    String   @map("user_account_id") @db.Uuid
  tripId           String   @map("trip_id") @db.Uuid
  tripSpotId       String   @map("trip_spot_id") @db.Uuid
  // 「同じ場所」の判定に使った正規化後の名前(0節: 名前がほぼ同じ・位置が近いスポットを
  // まとめて1日1回に制限するため)
  placeKey         String   @map("place_key")
  prefectureAreaId String?  @map("prefecture_area_id") @db.Uuid
  stampCategory    String?  @map("stamp_category")
  isMemorial       Boolean  @default(false) @map("is_memorial")
  checkedInAt      DateTime @default(now()) @map("checked_in_at") @db.Timestamptz

  userAccount UserAccount @relation(fields: [userAccountId], references: [id], onDelete: Cascade)
  trip        Trip        @relation(fields: [tripId], references: [id], onDelete: Cascade)
  tripSpot    TripSpot    @relation(fields: [tripSpotId], references: [id], onDelete: Cascade)

  @@index([userAccountId, checkedInAt])
  @@index([userAccountId, placeKey])
  @@map("checkin")
}

// 足あと地図の「行った・泊まった」(自己申告)
model PrefectureVisit {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userAccountId String    @map("user_account_id") @db.Uuid
  areaId        String    @map("area_id") @db.Uuid // 都道府県レベルのArea.id
  visitType     String    @map("visit_type") // "visited" | "stayed"
  visitDate     DateTime? @map("visit_date") @db.Date
  note          String?
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz

  userAccount UserAccount @relation(fields: [userAccountId], references: [id], onDelete: Cascade)
  area        Area        @relation(fields: [areaId], references: [id])

  @@unique([userAccountId, areaId])
  @@map("prefecture_visit")
}

// ============================================================
// 回数制限
// ============================================================

// ログイン失敗・会員登録・お問い合わせ等の回数制限用の記録。keyは「種類:対象」
// (例: "admin-login:email:xxx"、"user-login:ip:<ハッシュ>")形式の文字列で、
// 対象ごとの直近の件数を数えるのに使う。IPアドレスは平文で保存せずハッシュ化する。
// 24時間より古い記録は管理者サイトの日次Cronで削除する
model RateLimitEvent {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  key       String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@index([key, createdAt])
  @@map("rate_limit_event")
}

// ============================================================
// 退会後の保存記録
// ============================================================

// 退会(アカウント削除)のとき(管理者サイトからの削除も同じ)に、削除前の情報を
// ここへ移してから削除する。権利侵害の申告・開示請求への対応のための記録で、
// 6か月経過後にCronで個人情報を削除する(legalHold=trueのまま削除された記録は対象外)。
// 管理者サイトの画面には表示せず、Prismaのomitで既定では読み出さない
model DeletedAccountRecord {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  accountType       String   @map("account_type") // "user" | "planner"
  originalAccountId String   @map("original_account_id") @db.Uuid
  email             String?
  name              String?
  legalHold         Boolean  @default(false) @map("legal_hold")
  deletedAt         DateTime @default(now()) @map("deleted_at") @db.Timestamptz

  items DeletedAccountRecordItem[]

  @@index([deletedAt])
  @@map("deleted_account_record")
}

// 退会前6か月以内の投稿・送信の明細。リクエストは通信の秘密のため本文を保存しない(body=null)
model DeletedAccountRecordItem {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  recordId   String   @map("record_id") @db.Uuid
  kind       String // "comment" | "itinerary_submission" | "request"
  body       String?
  ipAddress  String?  @map("ip_address")
  occurredAt DateTime @map("occurred_at") @db.Timestamptz

  record DeletedAccountRecord @relation(fields: [recordId], references: [id], onDelete: Cascade)

  @@index([recordId])
  @@map("deleted_account_record_item")
}
