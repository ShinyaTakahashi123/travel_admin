# データベース（3サイト共有DB。マイグレーションはこのリポジトリ（admin-site）でのみ実行する）
# ⚠️ Vercel等のサーバーレス環境で動かす場合は、Neonの「プール接続（Pooled connection、
# ホスト名に -pooler が付いたもの）」を使うこと。直接接続だと毎リクエストで新規接続の
# オーバーヘッドが発生し、レスポンスが遅くなる（実際に発生した問題）。
DATABASE_URL="postgresql://user:password@host:5432/tabi_shiori"

# NextAuth（`npx auth secret` で生成したランダム値を設定）
AUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3002"

# 管理者サイトはGoogleログインを提供しない（自己登録なし・招待制のため）

# メール送信（管理者招待メール・パスワード再設定メール送信用）※サービス未選定。候補: Resend / SendGrid
EMAIL_SERVER=""
EMAIL_FROM=""

# 初回スーパー管理者シード用（scripts/seed.ts参照。本番環境では実行後に必ず削除・無効化すること）
SEED_SUPER_ADMIN_EMAIL=""
SEED_SUPER_ADMIN_PASSWORD=""
